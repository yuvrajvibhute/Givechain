# GiveChain — Environment Configuration
# Copy this file to .env and fill in values after running `npm run deploy`

# Active network: undeployed | preview | preprod
VITE_NETWORK=preview

# Contract address — VERIFIED on Preview testnet via indexer query 2026-09-26
# ee11e106e89fd0897ec108693963e0be0cdae8f41ae10e16afd63173fdbb7a9a returns live state on Preview
# For a fresh deployment: run `npm run deploy -- --network preview` and use the printed address
VITE_CONTRACT_ADDRESS=ee11e106e89fd0897ec108693963e0be0cdae8f41ae10e16afd63173fdbb7a9a

# Indexer URLs (API v4 — matches the backend network.ts configuration)
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws

# Proof server (local docker compose service for CLI/deploy; Lace uses its own proof server in browser)
VITE_PROOF_SERVER_URL=http://localhost:6300

# Wallet seed for CLI scripts (DO NOT commit this — add .env to .gitignore)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MIDNIGHT_WALLET_SEED=

# Private state encryption password (must be ≥16 chars; local devnet uses default placeholder)
PRIVATE_STATE_PASSWORD=Local-Devnet-Development-Placeholder-1
