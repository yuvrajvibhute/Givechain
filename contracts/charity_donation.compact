// ============================================================================
// MIDNIGHT COMPACT SMART CONTRACT: PRIVACY-PRESERVING CHARITY DONATION TRACKER
// ============================================================================
// PRIVACY DESIGN SPECIFICATION:
// ----------------------------------------------------------------------------
// PUBLIC ON-CHAIN STATE (Ledger):
//   - totalDonations: Uint<64> -> Total sum of all anonymous donations raised.
//   - campaignCount: Uint<64>  -> Total number of active charity causes.
//   - activeCampaignTitle: Opaque<"string"> -> Public active campaign description.
//
// PRIVATE WITNESS DATA (Off-Chain Secrets):
//   - donorSecret: Bytes<32>   -> Donor's private witness key / commitment seed.
//                                Never exposed or recorded on the public ledger.
//   - donorNote: Opaque<"string"> -> Private message from donor to charity.
//
// PROVED WITHOUT REVEALING:
//   - Proves the donor authorized a valid donation amount >= 1.
//   - Proves state transitions to totalDonations without revealing WHO donated.
// ============================================================================

pragma language_version >= 0.23;

import CompactStandardLibrary;

// Public ledger state
export ledger totalDonations: Uint<64>;
export ledger campaignCount: Uint<64>;
export ledger activeCampaignTitle: Opaque<"string">;

// Circuit: Initialize / Create a new Charity Campaign
export circuit createCampaign(title: Opaque<"string">): [] {
    activeCampaignTitle = disclose(title);
    campaignCount = campaignCount + 1;
}

// Circuit: Make a Privacy-Preserving Anonymous Donation
// Private Witness: donorSecret (Bytes<32>) is passed into circuit scope but NEVER disclosed.
export circuit donate(donorSecret: Bytes<32>, amount: Uint<64>): [] {
    // Constraint: Donation amount must be greater than zero
    assert(amount > 0, "Donation amount must be greater than zero");
    
    // Disclose ONLY the contribution amount to update the public tally
    const disclosedAmount = disclose(amount);
    
    // Increment on-chain ledger state
    totalDonations = totalDonations + disclosedAmount;
}
