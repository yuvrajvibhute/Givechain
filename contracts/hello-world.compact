// ============================================================================
// MIDNIGHT COMPACT SMART CONTRACT: PRIVACY-PRESERVING CHARITY DONATION TRACKER
// ============================================================================
// PRIVACY DESIGN SPECIFICATION:
// ----------------------------------------------------------------------------
// PUBLIC ON-CHAIN STATE (Ledger) — Visible to all via Midnight Indexer:
//   - totalDonations:     Uint<64>          → Total sum of all anonymous donations.
//   - campaignCount:      Uint<64>          → Number of active charity campaigns.
//   - activeCampaignTitle: Opaque<"string"> → Current public campaign description.
//
// PRIVATE WITNESS DATA (Off-Chain Secrets) — Never on-chain:
//   - donorSecret: Bytes<32> → Donor's private witness key / commitment seed.
//     Passed into circuit scope but NEVER disclosed or stored in ledger state.
//
// ZERO-KNOWLEDGE GUARANTEES:
//   - prove(donate): Proves donor authorized a valid amount >= 1 WITHOUT revealing:
//       * WHO made the donation (wallet identity hidden)
//       * The donor's witness seed or private key material
//   - prove(createCampaign): Proves a valid campaign title was registered.
//
// CIRCUIT PRIVACY ENFORCEMENT:
//   - `disclose(amount)` → Posts amount to ledger (public). Identity stays private.
//   - `disclose(title)`  → Posts campaign title to ledger (public).
//   - `donorSecret`      → Consumed in circuit scope only. Zero leakage.
// ============================================================================

pragma language_version >= 0.23;

import CompactStandardLibrary;

// ─── Public Ledger State (On-Chain) ──────────────────────────────────────────
export ledger totalDonations: Uint<64>;
export ledger campaignCount: Uint<64>;
export ledger activeCampaignTitle: Opaque<"string">;

// ─── Circuit: Initialize / Create a new Charity Campaign ─────────────────────
// PUBLIC INPUTS:  title (Opaque<"string">) — disclosed on-chain.
// PRIVATE INPUTS: none
// EFFECT: Updates activeCampaignTitle and increments campaignCount by 1.
export circuit createCampaign(title: Opaque<"string">): [] {
    activeCampaignTitle = disclose(title);
    campaignCount = campaignCount + 1;
}

// ─── Circuit: Make a Privacy-Preserving Anonymous Donation ───────────────────
// PUBLIC INPUTS:  amount (Uint<64>) — disclosed on-chain via disclose(amount).
// PRIVATE INPUTS: donorSecret (Bytes<32>) — witness key, NEVER disclosed.
// EFFECT: Asserts amount > 0, then adds disclosed amount to totalDonations.
// PRIVACY:  donorSecret is scoped to circuit execution only. No storage. No hash.
export circuit donate(donorSecret: Bytes<32>, amount: Uint<64>): [] {
    // Guard: donation must be non-zero
    assert(amount > 0, "Donation amount must be greater than zero");
    // Disclose only the amount — not the donor's identity or witness key
    const disclosedAmount = disclose(amount);
    totalDonations = totalDonations + disclosedAmount;
}
